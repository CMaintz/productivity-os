{
  "name": "productivity-os",
  "private": true,
  "type": "module",
  "scripts": {
    "inventory": "node tools/inventory/inventory.mjs --out out --github CMaintz",
    "test": "node --test \"tools/**/test/*.test.mjs\"",
    "vault": "node tools/vault/init.mjs --from-inventory out/inventory.json --git",
    "hooks": "node tools/hooks/install.mjs",
    "github": "node tools/github/sync.mjs",
    "suggest": "node tools/actions/suggest.mjs",
    "executor": "node tools/actions/executor.mjs --once",
    "dashboard": "node tools/dashboard/sync.mjs",
    "widgets:build": "node tools/widgets/code-registry.mjs && node tools/widgets/build-views.mjs && node tools/widgets/demo.mjs",
    "widget": "node tools/widgets/widgets.mjs",
    "code-widget": "node tools/widgets/code-widgets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "ts-morph": "^28.0.0",
    "typescript-eslint": "^8.71.2"
  },
  "workspaces": [
    "dashboard"
  ]
}
