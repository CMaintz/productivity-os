filters:
  and:
    - 'type == "project"'
views:
  - type: table
    name: Active
    filters:
      and:
        - 'status == "active"'
    order:
      - file.name
      - priority
      - next
      - ci
      - open_prs
      - agent_blocked
      - updated
  - type: table
    name: Needs attention
    filters:
      or:
        - 'ci == "failing"'
        - 'failing_prs > 0'
        - 'agent_blocked > 0'
    order:
      - file.name
      - ci
      - failing_prs
      - agent_blocked
      - next
  - type: table
    name: Paused & ideas
    filters:
      or:
        - 'status == "paused"'
        - 'status == "idea"'
    order:
      - file.name
      - status
      - next
      - updated
  - type: table
    name: All
    order:
      - file.name
      - status
      - area
      - repo
      - updated
