filters:
  and:
    - 'type == "action"'
views:
  - type: table
    name: Pending
    filters:
      and:
        - 'status == "pending"'
    order:
      - file.name
      - risk
      - reason
      - context
      - expires
  - type: table
    name: Ran on their own
    filters:
      and:
        - 'decided_by == "policy"'
        - 'status != "expired"'
    order:
      - file.name
      - status
      - action
      - finished_at
  - type: table
    name: Recent
    filters:
      and:
        - 'status != "pending"'
    order:
      - file.name
      - status
      - action
      - decided_by
      - finished_at
