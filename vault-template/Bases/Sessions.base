filters:
  and:
    - 'type == "session"'
views:
  - type: table
    name: Active
    filters:
      and:
        - 'status != "ended"'
    order:
      - project
      - status
      - waiting_for
      - last_prompt
      - updated
  - type: table
    name: Waiting on me
    filters:
      and:
        - 'status == "waiting"'
    order:
      - project
      - waiting_for
      - updated
  - type: table
    name: History
    filters:
      and:
        - 'status == "ended"'
    order:
      - project
      - prompts
      - started
      - updated
